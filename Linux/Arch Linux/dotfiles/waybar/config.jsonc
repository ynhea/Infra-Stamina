// -*- mode: jsonc -*-
{
    "layer": "top",
    "height": 30,
    "position": "top",

    // Choose the order of the modules
    "modules-left": ["custom/apple", "custom/finder"],
    "modules-center": [],
    "modules-right": ["battery", "network", "pulseaudio", "custom/control-center", "clock"],
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // }
 
   "custom/apple": {
        "format": "",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },
   "custom/finder": {
        "format": "Finder",
        "tooltip": false,
        "on-click": "dolphin"
    },
   "clock": {
	"format": "{:%a %d %b  %I:%M %p}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>"
    },
   "battery": {
        "format": "{icon}",
        "format-charging": "",
        "format-plugged": "",
        "format-full": "",

        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],

        "tooltip-format": "Battery: {capacity}%"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}\n{signalStrength}%",
        "on-click": "nm-connection-editor",
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "tooltip-format": "Volume: {volume}%",
    },
    "custom/control-center": {
        "format": "󰕮",
        "tooltip": "Control Center",
        "on-click": "sh ~/.config/hypr/scripts/control-center.sh"
    }
}

